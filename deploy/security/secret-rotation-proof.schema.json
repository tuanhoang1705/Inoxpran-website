{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inoxpran.example/schemas/secret-rotation-proof.schema.json",
  "title": "Inoxpran secret rotation proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "incidentReference",
    "reviewedCommit",
    "credentialClasses",
    "oldCredentialsRevokedAt",
    "newCredentialsActivatedAt",
    "secretStoreVersionReferences",
    "providerRevocationEvidenceReferences",
    "scopeVerificationReferences",
    "verifiedBy",
    "verifiedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "revoked_and_rotated"
    },
    "incidentReference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{2,239}$"
    },
    "reviewedCommit": {
      "type": "string",
      "pattern": "^(?!0{40})[A-Fa-f0-9]{40}$"
    },
    "credentialClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
      }
    },
    "oldCredentialsRevokedAt": {
      "type": "string",
      "format": "date-time"
    },
    "newCredentialsActivatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "secretStoreVersionReferences": {
      "$ref": "#/$defs/references"
    },
    "providerRevocationEvidenceReferences": {
      "$ref": "#/$defs/references"
    },
    "scopeVerificationReferences": {
      "$ref": "#/$defs/references"
    },
    "verifiedBy": {
      "$ref": "#/$defs/references"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{2,239}$"
      }
    }
  }
}
