{
  // Docker images are updated by the isolated Inoxpran updater service.
  // Disable the package self-updater/banner because it cannot replace a running image.
  update: {
    channel: "stable",
    checkOnStart: false,
    auto: { enabled: false },
  },
  gateway: {
    mode: "local",
    auth: {
      mode: "token",
      // Current Control UI assets are counted by the gateway auth limiter.
      rateLimit: {
        maxAttempts: 1000,
        windowMs: 60000,
        lockoutMs: 60000,
        exemptLoopback: true,
      },
    },
    http: {
      endpoints: {
        responses: { enabled: true },
      },
    },
    controlUi: {
      enabled: true,
      basePath: "/openclaw-dashboard",
      allowedOrigins: ["https://admin.inoxpran.com"],
      dangerouslyAllowHostHeaderOriginFallback: false,
      allowInsecureAuth: false,
      dangerouslyDisableDeviceAuth: false,
    },
  },
  skills: {
    load: {
      extraDirs: ["/workspaces/shared-skills"],
      watch: true,
    },
  },
  agents: {
    list: [
      {
        id: "seo-orchestrator",
        workspace: "/workspaces/seo-orchestrator",
        tools: { deny: ["exec", "process", "browser"] },
        skills: [
          "skill-vetter",
          "sharpagent-content-safety",
          "inoxpran-content-operations-contract",
          "inoxpran-content-work-order",
          "inoxpran-unified-content-brief",
          "inoxpran-brand-voice",
          "inoxpran-seo-review",
          "inoxpran-blog-editor-schema",
          "inoxpran-product-catalog-contract",
          "inoxpran-product-relevance-scoring",
          "inoxpran-contextual-product-seeding",
          "inoxpran-product-claim-safety",
          "inoxpran-product-seeding-review",
          "inoxpran-editorial-product-placement",
          "inoxpran-ranking-evidence-safety",
          "inoxpran-editorial-product-placement-review",
        ],
      },
      {
        id: "content-operations-orchestrator",
        workspace: "/workspaces/content-operations-orchestrator",
        tools: { deny: ["exec", "process", "browser"] },
        skills: [
          "google-intelligence-snapshot",
          "inoxpran-content-operations-contract",
          "inoxpran-daily-content-snapshot",
          "inoxpran-content-action-decision",
          "inoxpran-content-work-order",
          "inoxpran-unified-content-brief",
        ],
      },
      {
        id: "site-performance-analyst",
        workspace: "/workspaces/site-performance-analyst",
        tools: { deny: ["exec", "process", "browser"] },
        skills: [
          "inoxpran-daily-content-snapshot",
          "inoxpran-content-inventory",
