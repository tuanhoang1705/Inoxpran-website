{
  // TODO: Verify this schema against the installed OpenClaw version on the VPS.
  version: "1.0",
  project: "inoxpran-seo-automation",
  timezone: "Asia/Ho_Chi_Minh",
  stateDir: "/data",
  workspacesRoot: "/workspaces",
  gateway: {
    mode: "local"
  },
  dashboard: {
    public: false,
    // Bound inside the Docker network only. The compose service does not publish
    // this port and Nginx returns 403 for dashboard/public paths.
    bindHost: "0.0.0.0",
    port: 18789
  },
  security: {
    sandbox: {
      enabled: true,
      defaultNetwork: "limited",
      denySecretsInLogs: true
    },
    disallowDirectDatabaseAccess: true,
    disallowAdminUiPublishing: true,
    defaultPublishMode: "draft"
  },
  skills: {
    localDirectories: [
      "/workspaces/shared-skills"
    ],
    // Core ClawHub skills must pass `openclaw skills verify` before install.
    // Do not add a skill here if verify returns fail/pending.
    globalAllowlist: [
      "skill-vetter",
      "ddg-search",
      "firecrawl",
      "Market Research",
      "research-agent",
      "content-generation",
      "AI Image Generation",
      "inoxpran-search-console",
      "inoxpran-brand-voice",
      "inoxpran-seo-research-brief",
      "inoxpran-positioning",
      "inoxpran-topic-planner",
      "inoxpran-blog-image-brief",
      "inoxpran-seo-publisher",
      "inoxpran-seo-review"
    ]
  },
  agents: [
    {
      name: "seo-orchestrator",
      workspace: "/workspaces/seo-orchestrator",
      promptFile: "/workspaces/prompts/daily-seo-blog.md",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "skill-vetter",
        "inoxpran-brand-voice",
        "inoxpran-seo-review"
      ]
    },
    {
      name: "market-insight-analyst",
      workspace: "/workspaces/market-insight-analyst",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "ddg-search",
        "firecrawl",
        "Market Research",
        "research-agent",
        "inoxpran-search-console",
        "inoxpran-seo-research-brief",
        "inoxpran-positioning"
      ]
    },
    {
      name: "keyword-researcher",
      workspace: "/workspaces/keyword-researcher",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "ddg-search",
        "firecrawl",
        "inoxpran-search-console",
        "inoxpran-seo-research-brief"
      ]
    },
    {
      name: "content-ideator",
      workspace: "/workspaces/content-ideator",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "Market Research",
        "content-generation",
        "inoxpran-brand-voice",
        "inoxpran-positioning",
        "inoxpran-topic-planner"
      ]
    },
    {
      name: "seo-strategist",
      workspace: "/workspaces/seo-strategist",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "Market Research",
        "content-generation",
        "inoxpran-brand-voice",
        "inoxpran-positioning",
        "inoxpran-topic-planner",
        "inoxpran-seo-review"
      ]
    },
    {
      name: "content-writer",
      workspace: "/workspaces/content-writer",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "content-generation",
        "inoxpran-brand-voice",
        "inoxpran-positioning"
      ]
    },
    {
      name: "image-planner",
      workspace: "/workspaces/image-planner",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "AI Image Generation",
        "inoxpran-brand-voice",
        "inoxpran-blog-image-brief"
      ]
    },
    {
      name: "seo-reviewer",
      workspace: "/workspaces/seo-reviewer",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "skill-vetter",
        "inoxpran-brand-voice",
        "inoxpran-seo-review"
      ]
    },
    {
      name: "publisher",
      workspace: "/workspaces/publisher",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "inoxpran-seo-publisher"
      ],
      publishPolicy: {
        defaultMode: "draft",
        requireReviewerPass: true,
        minSeoScoreEnv: "SEO_AGENT_MIN_SEO_SCORE",
        autoPublishEnv: "SEO_AGENT_AUTO_PUBLISH"
      }
    },
    {
      name: "qa-agent",
      workspace: "/workspaces/qa-agent",
      tools: {
        shell: false,
        browser: true,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "ddg-search",
        "firecrawl"
      ]
    },
    {
      name: "reporter",
      workspace: "/workspaces/reporter",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "skill-vetter"
      ]
    }
  ]
}
