{
  // TODO: Verify this schema against the installed OpenClaw version on the VPS.
  version: "1.0",
  project: "inoxpran-seo-automation",
  timezone: "Asia/Ho_Chi_Minh",
  stateDir: "/data",
  workspacesRoot: "/workspaces",
  gateway: {
    mode: "local"
  },
  dashboard: {
    public: false,
    // Bound inside the Docker network only. The compose service does not publish
    // this port and Nginx returns 403 for dashboard/public paths.
    bindHost: "0.0.0.0",
    port: 18789
  },
  security: {
    sandbox: {
      enabled: true,
      defaultNetwork: "limited",
      denySecretsInLogs: true
    },
    disallowDirectDatabaseAccess: true,
    disallowAdminUiPublishing: true,
    defaultPublishMode: "draft"
  },
  skills: {
    localDirectories: [
      "/workspaces/shared-skills"
    ],
    // Core ClawHub skills must pass `openclaw skills verify` before install.
    // Do not add a skill here if verify returns fail/pending.
    globalAllowlist: [
      "skill-vetter",
      "ddg-search",
      "firecrawl",
      "Market Research",
      "research-agent",
      "content-generation",
      "AI Image Generation",
      "google-search-console-seo",
      "sharpagent-content-safety",
      "inoxpran-search-console",
      "google-search-source-policy",
      "google-intelligence-snapshot",
      "inoxpran-editorial-style-rotation",
      "inoxpran-originality-gate",
      "inoxpran-people-first-review",
      "inoxpran-blog-strategy-contract",
      "inoxpran-source-attribution",
      "inoxpran-telegram-approval-contract",
      "inoxpran-brand-voice",
      "inoxpran-seo-research-brief",
      "inoxpran-positioning",
      "inoxpran-topic-planner",
      "inoxpran-blog-image-brief",
      "inoxpran-visual-plan",
      "inoxpran-image-quality",
      "inoxpran-image-metadata",
      "inoxpran-publisher-gate",
      "inoxpran-seo-publisher",
      "inoxpran-seo-review",
      "inoxpran-blog-editor-schema"
    ]
  },
  agents: [
    {
      name: "seo-orchestrator",
      workspace: "/workspaces/seo-orchestrator",
      promptFile: "/workspaces/prompts/daily-seo-blog.md",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "skill-vetter",
        "sharpagent-content-safety",
        "inoxpran-brand-voice",
        "inoxpran-seo-review",
        "inoxpran-blog-editor-schema"
      ]
    },
    {
      name: "market-insight-analyst",
      workspace: "/workspaces/market-insight-analyst",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "ddg-search",
        "firecrawl",
        "Market Research",
        "research-agent",
        "inoxpran-search-console",
        "inoxpran-seo-research-brief",
        "inoxpran-positioning"
      ]
    },
    {
      name: "keyword-researcher",
      workspace: "/workspaces/keyword-researcher",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "ddg-search",
        "firecrawl",
        "inoxpran-search-console",
        "inoxpran-seo-research-brief"
      ]
    },
    {
      name: "content-ideator",
      workspace: "/workspaces/content-ideator",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "Market Research",
        "content-generation",
        "inoxpran-brand-voice",
        "inoxpran-positioning",
        "inoxpran-topic-planner"
      ]
    },
    {
      name: "seo-strategist",
      workspace: "/workspaces/seo-strategist",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "Market Research",
        "content-generation",
        "inoxpran-brand-voice",
        "inoxpran-positioning",
        "inoxpran-topic-planner",
        "inoxpran-seo-review"
      ]
    },
    {
      name: "content-writer",
      workspace: "/workspaces/content-writer",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "content-generation",
        "inoxpran-brand-voice",
        "inoxpran-positioning",
        "inoxpran-blog-editor-schema",
        "inoxpran-blog-strategy-contract",
        "inoxpran-editorial-style-rotation",
        "inoxpran-source-attribution"
      ]
    },
    {
      name: "image-planner",
      workspace: "/workspaces/image-planner",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "AI Image Generation",
        "inoxpran-brand-voice",
        "inoxpran-blog-image-brief"
      ]
    },
    {
      name: "visual-planner",
      workspace: "/workspaces/visual-planner",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-visual-plan", "inoxpran-blog-editor-schema"]
    },
    {
      name: "image-researcher",
      workspace: "/workspaces/image-researcher",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-visual-plan", "inoxpran-image-quality"]
    },
    {
      name: "image-prompt-builder",
      workspace: "/workspaces/image-prompt-builder",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-visual-plan", "inoxpran-blog-image-brief"]
    },
    {
      name: "image-quality-reviewer",
      workspace: "/workspaces/image-quality-reviewer",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-image-quality"]
    },
    {
      name: "seo-image-metadata",
      workspace: "/workspaces/seo-image-metadata",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-image-metadata"]
    },
    {
      name: "publisher-gatekeeper",
      workspace: "/workspaces/publisher-gatekeeper",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: [
        "inoxpran-publisher-gate",
        "inoxpran-seo-review",
        "google-intelligence-snapshot",
        "inoxpran-originality-gate",
        "inoxpran-people-first-review"
      ]
    },
    {
      name: "search-console-reporter",
      workspace: "/workspaces/search-console-reporter",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["google-search-console-seo", "inoxpran-search-console"]
    },
    {
      name: "seo-reviewer",
      workspace: "/workspaces/seo-reviewer",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "skill-vetter",
        "sharpagent-content-safety",
        "inoxpran-brand-voice",
        "inoxpran-seo-review",
        "inoxpran-blog-editor-schema"
      ]
    },
    {
      name: "publisher",
      workspace: "/workspaces/publisher",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "inoxpran-seo-publisher"
      ],
      publishPolicy: {
        defaultMode: "draft",
        requireReviewerPass: true,
        minSeoScoreEnv: "SEO_AGENT_MIN_SEO_SCORE",
        autoPublishEnv: "SEO_AGENT_AUTO_PUBLISH"
      }
    },
    {
      name: "qa-agent",
      workspace: "/workspaces/qa-agent",
      tools: {
        shell: false,
        browser: true,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "ddg-search",
        "firecrawl"
      ]
    },
    {
      name: "google-source-monitor",
      workspace: "/workspaces/google-source-monitor",
      tools: { shell: false, browser: true, mongodb: false, adminUi: false },
      skillAllowlist: ["google-search-source-policy"]
    },
    {
      name: "google-change-detector",
      workspace: "/workspaces/google-change-detector",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["google-search-source-policy", "google-intelligence-snapshot"]
    },
    {
      name: "google-policy-analyst",
      workspace: "/workspaces/google-policy-analyst",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["google-search-source-policy", "inoxpran-source-attribution"]
    },
    {
      name: "google-intelligence-reviewer",
      workspace: "/workspaces/google-intelligence-reviewer",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["google-search-source-policy", "google-intelligence-snapshot", "inoxpran-source-attribution"]
    },
    {
      name: "google-intelligence-gatekeeper",
      workspace: "/workspaces/google-intelligence-gatekeeper",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["google-intelligence-snapshot"]
    },
    {
      name: "seo-aeo-geo-strategist",
      workspace: "/workspaces/seo-aeo-geo-strategist",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["google-intelligence-snapshot", "inoxpran-source-attribution", "inoxpran-seo-review"]
    },
    {
      name: "topic-opportunity-researcher",
      workspace: "/workspaces/topic-opportunity-researcher",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-topic-planner", "inoxpran-blog-strategy-contract", "inoxpran-search-console"]
    },
    {
      name: "industry-content-researcher",
      workspace: "/workspaces/industry-content-researcher",
      tools: { shell: false, browser: true, mongodb: false, adminUi: false },
      skillAllowlist: ["ddg-search", "firecrawl", "google-search-source-policy", "inoxpran-source-attribution"]
    },
    {
      name: "search-intent-analyst",
      workspace: "/workspaces/search-intent-analyst",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-blog-strategy-contract"]
    },
    {
      name: "editorial-style-planner",
      workspace: "/workspaces/editorial-style-planner",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-editorial-style-rotation"]
    },
    {
      name: "content-strategist",
      workspace: "/workspaces/content-strategist",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-blog-strategy-contract", "inoxpran-brand-voice", "inoxpran-source-attribution"]
    },
    {
      name: "content-architect",
      workspace: "/workspaces/content-architect",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-blog-strategy-contract", "inoxpran-editorial-style-rotation", "inoxpran-blog-editor-schema"]
    },
    {
      name: "originality-reviewer",
      workspace: "/workspaces/originality-reviewer",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-originality-gate"]
    },
    {
      name: "spam-risk-reviewer",
      workspace: "/workspaces/spam-risk-reviewer",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-people-first-review", "google-intelligence-snapshot"]
    },
    {
      name: "fact-checker",
      workspace: "/workspaces/fact-checker",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-source-attribution", "inoxpran-brand-voice"]
    },
    {
      name: "brand-voice-reviewer",
      workspace: "/workspaces/brand-voice-reviewer",
      tools: { shell: false, browser: false, mongodb: false, adminUi: false },
      skillAllowlist: ["inoxpran-brand-voice"]
    },
    {
      name: "reporter",
      workspace: "/workspaces/reporter",
      tools: {
        shell: false,
        browser: false,
        mongodb: false,
        adminUi: false
      },
      skillAllowlist: [
        "skill-vetter"
      ]
    }
  ]
}
