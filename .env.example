# Backend automation API
SEO_AGENT_ENABLED=false
SEO_AGENT_AUTO_PUBLISH=false
SEO_AGENT_API_KEY=
SEO_AGENT_HMAC_SECRET=
SEO_AGENT_ALLOWED_IPS=
SEO_AGENT_DEFAULT_AUTHOR=Inoxpran Editorial Team
SEO_AGENT_DEFAULT_BLOG_IMAGE=/og-image.png
SEO_AGENT_MIN_SEO_SCORE=85
SEO_AGENT_MIN_WORDS=800
SEO_AGENT_MAX_WORDS=1800

# OpenClaw blog schedule runtime
OPENCLAW_BLOG_CRON_ENABLED=false
OPENCLAW_BLOG_CRON_POLL_MS=30000
OPENCLAW_BLOG_CRON_TIMEZONE=Asia/Ho_Chi_Minh

# Mandatory Google Search Intelligence gate and persistent schedule
GOOGLE_INTELLIGENCE_ENABLED=false
GOOGLE_INTELLIGENCE_TIMEZONE=Asia/Ho_Chi_Minh
GOOGLE_INTELLIGENCE_DAILY_TIME=05:30
GOOGLE_INTELLIGENCE_STRICT_GATE=true
GOOGLE_INTELLIGENCE_MAX_SNAPSHOT_AGE_HOURS=24
GOOGLE_INTELLIGENCE_ALLOW_LAST_SUCCESSFUL=false
GOOGLE_INTELLIGENCE_RETRY_COUNT=2
GOOGLE_INTELLIGENCE_SOURCE_TIMEOUT_MS=15000

# Telegram draft approval. Keep real values only in local/VPS .env, never in git.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://inoxpran.com/v1/api/integrations/telegram/webhook
TELEGRAM_APPROVAL_TTL_HOURS=72
TELEGRAM_MODE=webhook
TELEGRAM_POLL_INTERVAL_MS=1500
TELEGRAM_IMAGE_TIMEOUT_MS=8000
TELEGRAM_IMAGE_MAX_BYTES=5242880
ADMIN_BASE_URL=http://localhost:5173

# Agentic Blog Core V2 research, rotation and originality gates
EDITORIAL_STYLE_ROTATION_ENABLED=true
EDITORIAL_STYLE_LOOKBACK_DAYS=14
EDITORIAL_STYLE_DEFAULT_COOLDOWN_DAYS=7
CONTENT_ORIGINALITY_GATE_ENABLED=true
CONTENT_SIMILARITY_THRESHOLD=0.82
CONTENT_HEADING_SIMILARITY_THRESHOLD=0.72
CONTENT_STRUCTURAL_SIMILARITY_THRESHOLD=0.78
INDUSTRY_RESEARCH_ENABLED=true
INDUSTRY_RESEARCH_MAX_SOURCES=8
INDUSTRY_RESEARCH_LOOKBACK_DAYS=90
INDUSTRY_RESEARCH_SOURCE_URLS=

# Content Operations Lifecycle V3. Both planning and cron are opt-in until a reviewed rollout.
CONTENT_OPERATIONS_ENABLED=false
CONTENT_OPERATIONS_TIMEZONE=Asia/Ho_Chi_Minh
CONTENT_OPERATIONS_CRON_ENABLED=false
CONTENT_OPERATIONS_DAILY_TIME=06:30
CONTENT_OPERATIONS_SNAPSHOT_TTL_HOURS=24
CONTENT_OPERATIONS_MAX_ACTIONS_PER_DAY=1
CONTENT_OPERATIONS_WORK_ORDER_LEASE_MINUTES=60
CONTENT_OPERATIONS_MIN_OPPORTUNITY_SCORE=0.65
CONTENT_OPERATIONS_MIN_USER_VALUE_SCORE=0.20
CONTENT_OPERATIONS_ALLOW_SKIP=true

CONTENT_INVENTORY_ENABLED=true
CONTENT_INVENTORY_SNAPSHOT_TTL_HOURS=24
CONTENT_INVENTORY_STALE_DAYS=180
CONTENT_INVENTORY_REVIEW_DAYS=90

CONTENT_SIGNALS_ENABLED=true
CONTENT_SIGNAL_DEFAULT_TTL_DAYS=90
CONTENT_SIGNAL_MAX_LENGTH=2000

CONTENT_PERFORMANCE_MONITORING_ENABLED=false
CONTENT_MONITOR_WINDOWS=1d,7d,14d,30d,90d
CONTENT_LEARNING_ENABLED=false
CONTENT_LEARNING_MIN_AGE_DAYS=14
CONTENT_LEARNING_MIN_IMPRESSIONS=100
CONTENT_LEARNING_AUTO_APPLY=false

SEARCH_CONSOLE_ENABLED=false
# Exact property granted to the mounted service account, for example sc-domain:example.com.
SEARCH_CONSOLE_PROPERTY=
SEARCH_CONSOLE_LOOKBACK_DAYS=90
CONTENT_ANALYTICS_ENABLED=false
CONTENT_TRENDS_ENABLED=false
CONTENT_TRENDS_PROVIDER=google_trends_rss
CONTENT_TRENDS_GEO=VN
CONTENT_TRENDS_MAX_SIGNALS=50
CONTENT_TRENDS_MAX_RESPONSE_BYTES=524288
CONTENT_PUBLISH_READINESS_ENABLED=true
CONTENT_POST_PUBLISH_VERIFY_ENABLED=true

CONTENT_ACTION_WEIGHT_USER_DEMAND=0.20
CONTENT_ACTION_WEIGHT_CONTENT_GAP=0.15
CONTENT_ACTION_WEIGHT_PERFORMANCE=0.15
CONTENT_ACTION_WEIGHT_BUSINESS=0.15
CONTENT_ACTION_WEIGHT_FRESHNESS=0.10
CONTENT_ACTION_WEIGHT_CUSTOMER_SIGNAL=0.10
CONTENT_ACTION_WEIGHT_PRODUCT_CAMPAIGN=0.05
CONTENT_ACTION_WEIGHT_EVIDENCE=0.05
CONTENT_ACTION_WEIGHT_INTERNAL_LINK=0.05

# Keep service-account JSON outside the Docker image and mount it read-only at runtime.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=./backend/credentials/file.json

# Product relevance and contextual seeding intelligence
PRODUCT_SEEDING_ENABLED=true
PRODUCT_SEEDING_DEFAULT_MODE=auto
PRODUCT_SEEDING_DEFAULT_INTENSITY=light
PRODUCT_SEED_MIN_RELEVANCE_SCORE=0.72
PRODUCT_SEED_MAX_PRIMARY_PRODUCTS=1
PRODUCT_SEED_MAX_SUPPORTING_PRODUCTS=2
PRODUCT_SEED_LOOKBACK_DAYS=30
PRODUCT_SEED_PRODUCT_COOLDOWN_DAYS=7
PRODUCT_SEED_ALLOW_OUT_OF_STOCK=false
PRODUCT_SEED_REQUIRE_ACTIVE_PRODUCT=true
PRODUCT_SEED_REQUIRE_CANONICAL_URL=true
PRODUCT_SEED_MAX_MENTIONS_LIGHT=2
PRODUCT_SEED_MAX_MENTIONS_BALANCED=4
PRODUCT_SEED_MAX_MENTIONS_COMMERCIAL=6
PRODUCT_SEED_MAX_PRODUCT_LINKS=2
PRODUCT_SEED_MAX_CTA_COUNT=1
PRODUCT_CATALOG_SNAPSHOT_TTL_MINUTES=30
PRODUCT_CATALOG_MIN_DATA_COMPLETENESS=0.60

# Independent editorial product-placement strategy and deterministic gates
PRODUCT_PLACEMENT_ENABLED=true
PRODUCT_PLACEMENT_DEFAULT_STYLE=auto
PRODUCT_PLACEMENT_MIN_SECTIONS_BEFORE_PRODUCT=2
PRODUCT_PLACEMENT_MIN_WORDS_BEFORE_PRODUCT=350
PRODUCT_PLACEMENT_MIN_PROGRESS_PERCENT=35
PRODUCT_PLACEMENT_STYLE_LOOKBACK_DAYS=14
PRODUCT_PLACEMENT_STYLE_COOLDOWN_DAYS=5
PRODUCT_PLACEMENT_RANKING_POSITION_MODE=auto
PRODUCT_PLACEMENT_RANKING_POSITION_LOOKBACK_DAYS=14
PRODUCT_PLACEMENT_ALLOW_OWNED_PRODUCT_MIDDLE=false
PRODUCT_PLACEMENT_ALLOW_PRODUCT_IN_INTRO=false
PRODUCT_PLACEMENT_ALLOW_PRODUCT_IMAGE_FIRST=false
PRODUCT_PLACEMENT_ALLOW_CONSECUTIVE_PRODUCT_BLOCKS=false
PRODUCT_PLACEMENT_ALLOW_CONSECUTIVE_PRODUCT_IMAGES=false
PRODUCT_PLACEMENT_REQUIRE_DISCLOSURE=true
PRODUCT_PLACEMENT_REQUIRE_RANKING_METHODOLOGY=true
PRODUCT_PLACEMENT_REQUIRE_BESTSELLER_EVIDENCE=true
PRODUCT_PLACEMENT_MAX_BLOCKS_LIGHT=1
PRODUCT_PLACEMENT_MAX_BLOCKS_BALANCED=2
PRODUCT_PLACEMENT_MAX_CTA=1

# OpenClaw Visual SEO pipeline
OPENCLAW_IMAGE_PIPELINE_ENABLED=false
OPENCLAW_REQUIRE_COVER_IMAGE_FOR_PUBLISH=true
IMAGE_SEARCH_PROVIDER=disabled
IMAGE_SEARCH_API_KEY=
AI_IMAGE_PROVIDER=disabled
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-2
IMAGE_MAX_INLINE_COUNT=4
IMAGE_COVER_WIDTH=1200
IMAGE_COVER_HEIGHT=675
IMAGE_OG_WIDTH=1200
IMAGE_OG_HEIGHT=630
IMAGE_MAX_FILE_SIZE_KB=350

# OpenClaw publisher runtime
OPENCLAW_GATEWAY_TOKEN=
INOXPRAN_BACKEND_API_BASE=http://backend:3056/v1/api
INOXPRAN_PUBLIC_SITE_URL=https://inoxpran.com
INOXPRAN_SEO_AGENT_AUTO_PUBLISH=false
INOXPRAN_SEO_AGENT_API_KEY=
INOXPRAN_SEO_AGENT_HMAC_SECRET=

# Optional ClawHub research/image-provider integrations
FIRECRAWL_API_KEY=
