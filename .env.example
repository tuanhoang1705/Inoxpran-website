# Backend automation API
SEO_AGENT_ENABLED=false
SEO_AGENT_AUTO_PUBLISH=false
SEO_AGENT_API_KEY=
SEO_AGENT_HMAC_SECRET=
SEO_AGENT_ALLOWED_IPS=
SEO_AGENT_DEFAULT_AUTHOR=Inoxpran Editorial Team
SEO_AGENT_DEFAULT_BLOG_IMAGE=/og-image.png
SEO_AGENT_MIN_SEO_SCORE=85
SEO_AGENT_MIN_WORDS=800
SEO_AGENT_MAX_WORDS=1800

# OpenClaw blog schedule runtime
OPENCLAW_BLOG_CRON_ENABLED=false
OPENCLAW_BLOG_CRON_POLL_MS=30000
OPENCLAW_BLOG_CRON_TIMEZONE=Asia/Ho_Chi_Minh

# Telegram draft approval. Keep real values only in local/VPS .env, never in git.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://inoxpran.com/v1/api/integrations/telegram/webhook
TELEGRAM_APPROVAL_TTL_HOURS=72

# OpenClaw Visual SEO pipeline
OPENCLAW_IMAGE_PIPELINE_ENABLED=true
OPENCLAW_REQUIRE_COVER_IMAGE_FOR_PUBLISH=true
IMAGE_SEARCH_PROVIDER=disabled
IMAGE_SEARCH_API_KEY=
AI_IMAGE_PROVIDER=disabled
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-2
IMAGE_MAX_INLINE_COUNT=4
IMAGE_COVER_WIDTH=1200
IMAGE_COVER_HEIGHT=675
IMAGE_OG_WIDTH=1200
IMAGE_OG_HEIGHT=630
IMAGE_MAX_FILE_SIZE_KB=350

# OpenClaw publisher runtime
OPENCLAW_GATEWAY_TOKEN=
INOXPRAN_BACKEND_API_BASE=http://backend:3056/v1/api
INOXPRAN_PUBLIC_SITE_URL=https://inoxpran.com
INOXPRAN_SEO_AGENT_AUTO_PUBLISH=false
INOXPRAN_SEO_AGENT_API_KEY=
INOXPRAN_SEO_AGENT_HMAC_SECRET=

# Optional ClawHub research/image-provider integrations
FIRECRAWL_API_KEY=
