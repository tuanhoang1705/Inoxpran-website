# Core runtime. Production receives these through the process/secret store; the
# backend never loads a dotenv file when NODE_ENV=production. For local work it
# loads only the repository-root .env, or the single file named by LOCAL_ENV_FILE.
NODE_ENV=development
LOCAL_ENV_FILE=
HOST=0.0.0.0
PORT=3056
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3056/v1/api
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5173/admin
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
ERROR_INCLUDE_STACK=false
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=15000

# Database and cache secrets must remain empty in git.
MONGODB_URI=
MONGOOSE_AUTO_INDEX=true
BOOTSTRAP_CREATE_INDEXES=false
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
REDIS_URL=
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TLS_CA_FILE=
REDIS_TLS_SERVERNAME=redis
# Production Compose mounts ca.crt, server.crt and server.key from this
# secret-store-managed host directory and always enables TLS.
REDIS_TLS_CERT_DIR=
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_STARTUP_TIMEOUT_MS=15000
REDIS_ERROR_LOG_WINDOW_MS=30000

# Caller-scoped application keys. Use four distinct random values. Production
# rejects API_KEY and the previous broad aliases instead of falling back.
PUBLIC_API_KEY=
USER_API_KEY=
ADMIN_BFF_API_KEY=
OPENCLAW_INTERNAL_API_KEY=
JWT_SECRET=

# HTTP abuse controls.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_BLOCK_SECONDS=300

# Supply reviewed image references explicitly. Production deploy requires every
# core image reference to include an operator-reviewed @sha256 digest.
APP_RELEASE=local
NODE_RUNTIME_IMAGE=
REDIS_IMAGE=
NGINX_IMAGE=
CERTBOT_IMAGE=
N8N_IMAGE=
OPENCLAW_IMAGE=
# Absolute package path inside the reviewed OpenClaw image. Production
# preflight mounts the read-only verifier and rejects an unpatched image.
OPENCLAW_PACKAGE_ROOT=

# Private 9router sidecar. Keep its persistent DATA_DIR in an existing writable
# directory outside the checkout and never publish port 20128 on a production
# host. Every secret below must contain at least 32 non-placeholder characters;
# keep all five values distinct.
NINE_ROUTER_IMAGE=
NINE_ROUTER_DATA_HOST_PATH=
NINE_ROUTER_API_KEY=
NINE_ROUTER_JWT_SECRET=
NINE_ROUTER_INITIAL_PASSWORD=
NINE_ROUTER_API_KEY_SECRET=
NINE_ROUTER_MACHINE_ID_SALT=

# Backend automation API
SEO_AGENT_ENABLED=false
SEO_AGENT_AUTO_PUBLISH=false
OPENCLAW_BLOG_AUTO_PUBLISH=false
SEO_AGENT_API_KEY=
SEO_AGENT_HMAC_SECRET=
CONTENT_OPERATIONS_AUDIT_HMAC_SECRET=
SEO_AGENT_ALLOWED_IPS=
SEO_AGENT_DEFAULT_AUTHOR=Inoxpran Editorial Team
SEO_AGENT_DEFAULT_BLOG_IMAGE=/og-image.png
SEO_AGENT_MIN_SEO_SCORE=85
SEO_AGENT_MIN_WORDS=800
SEO_AGENT_MAX_WORDS=1800

# OpenClaw blog schedule runtime
OPENCLAW_BLOG_CRON_ENABLED=false
OPENCLAW_BLOG_CRON_POLL_MS=30000
OPENCLAW_BLOG_CRON_TIMEZONE=Asia/Ho_Chi_Minh
# Local development may embed the durable consumer in the API process.
# Production must set this false and run `npm run worker` as a separate service.
OPENCLAW_EMBEDDED_WORKER=true
OPENCLAW_WORKER_HEALTH_PORT=3057
OPENCLAW_WORKER_DRAIN_TIMEOUT_MS=15000
# Same execution/document is retained across these whole-workflow retries.
OPENCLAW_BLOG_RETRY_MAX_ATTEMPTS=3
OPENCLAW_BLOG_RETRY_BASE_MS=30000
OPENCLAW_BLOG_RETRY_MAX_MS=900000
# Each OpenClaw request phase retries transient transport/provider failures.
# One JSON-repair phase may run after a successful but malformed primary output.
OPENCLAW_AGENT_TRANSPORT_MAX_ATTEMPTS_PER_PHASE=3
OPENCLAW_AGENT_RETRY_BASE_MS=500

# Shared OpenAI credential. The customer-support model is optional.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# Explicit blog models. Production requires both when blog cron or the topic
# roadmap is enabled; there is no shared-model fallback.
OPENAI_WRITER_MODEL=
OPENAI_IDEATION_MODEL=

# Read-only capability health. Probes never generate content or call outbound providers.
OPENCLAW_CAPABILITY_HEALTH_ENABLED=true
OPENCLAW_CAPABILITY_HEALTH_CACHE_SECONDS=30
OPENCLAW_CAPABILITY_HEALTH_TIMEOUT_MS=10000

# Independent Agentic Blog QA. Keep state-changing QA disabled outside isolated test environments.
AGENTIC_BLOG_QA_ENABLED=false
AGENTIC_BLOG_QA_ENVIRONMENT=local
AGENTIC_BLOG_QA_DATABASE_NAME=inoxpran_qa_local
# Exact immutable revision running this backend; required before shared/systemic remediation.
AGENTIC_BLOG_QA_CODE_REVISION=
AGENTIC_BLOG_QA_REQUIRED_SCORE=81
AGENTIC_BLOG_QA_MAX_ITERATIONS=3
AGENTIC_BLOG_QA_REQUIRE_ALL_CASES_PASS=true
AGENTIC_BLOG_QA_ALLOW_PUBLIC_PUBLISH=false
AGENTIC_BLOG_QA_TELEGRAM_ENABLED=false
AGENTIC_BLOG_QA_PAID_IMAGES_ENABLED=false
AGENTIC_BLOG_QA_BLIND_REVIEW_ENABLED=true
AGENTIC_BLOG_QA_TOPIC_UNIQUENESS_ENABLED=true
AGENTIC_BLOG_QA_LOCAL_RUN_NOW_CASES=3
AGENTIC_BLOG_QA_LOCAL_SCHEDULE_CASES=3
AGENTIC_BLOG_QA_STAGING_RUN_NOW_CASES=2
AGENTIC_BLOG_QA_STAGING_SCHEDULE_CASES=2
SENIOR_BLOG_AUDITOR_ENABLED=true
SENIOR_BLOG_AUDITOR_REQUIRED_SCORE=81
SENIOR_BLOG_AUDITOR_HARD_GATES_ENABLED=true
SENIOR_BLOG_AUDITOR_TIMEOUT_MS=8000

# Mandatory Google Search Intelligence gate and persistent schedule.
# Keep this enabled on every worker that runs SEO_AGENT_ENABLED or blog cron.
GOOGLE_INTELLIGENCE_ENABLED=false
GOOGLE_INTELLIGENCE_TIMEZONE=Asia/Ho_Chi_Minh
GOOGLE_INTELLIGENCE_DAILY_TIME=05:30
GOOGLE_INTELLIGENCE_STRICT_GATE=true
GOOGLE_INTELLIGENCE_MAX_SNAPSHOT_AGE_HOURS=24
GOOGLE_INTELLIGENCE_ALLOW_LAST_SUCCESSFUL=false
GOOGLE_INTELLIGENCE_RETRY_COUNT=2
GOOGLE_INTELLIGENCE_SOURCE_TIMEOUT_MS=15000

# Telegram draft approval. Keep real values only in local/VPS .env, never in git.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://inoxpran.com/v1/api/integrations/telegram/webhook
TELEGRAM_APPROVAL_TTL_HOURS=72
TELEGRAM_MODE=webhook
TELEGRAM_POLL_INTERVAL_MS=1500
TELEGRAM_IMAGE_TIMEOUT_MS=8000
TELEGRAM_IMAGE_MAX_BYTES=5242880

# Agentic Blog Core V2 research, rotation and originality gates
EDITORIAL_STYLE_ROTATION_ENABLED=true
EDITORIAL_STYLE_LOOKBACK_DAYS=14
EDITORIAL_STYLE_DEFAULT_COOLDOWN_DAYS=7
CONTENT_ORIGINALITY_GATE_ENABLED=true
CONTENT_SIMILARITY_THRESHOLD=0.82
CONTENT_HEADING_SIMILARITY_THRESHOLD=0.72
CONTENT_STRUCTURAL_SIMILARITY_THRESHOLD=0.78

# Smart rolling topic roadmap for simple Blog schedules. Enabled by default in
# code even when CONTENT_OPERATIONS_ENABLED=false; these are optional tuning knobs.
OPENCLAW_TOPIC_ROADMAP_ENABLED=true
OPENCLAW_TOPIC_ROADMAP_MIN_READY=3
OPENCLAW_TOPIC_ROADMAP_TARGET_READY=8
OPENCLAW_TOPIC_ROADMAP_MAX_CANDIDATES=24
OPENCLAW_TOPIC_ROADMAP_REFILL_LEASE_MS=600000
OPENCLAW_TOPIC_ROADMAP_CLAIM_LEASE_MS=5400000
OPENCLAW_TOPIC_ROADMAP_MAX_CLAIM_ATTEMPTS=3
OPENCLAW_TOPIC_ROADMAP_REGENERATION_LEASE_MS=120000
OPENCLAW_TOPIC_ROADMAP_REGENERATION_RETRY_DELAY_MS=30000
OPENCLAW_TOPIC_ROADMAP_REGENERATION_MAX_ATTEMPTS=5
OPENCLAW_TOPIC_ROADMAP_WORKER_POLL_MS=5000
OPENCLAW_TOPIC_ROADMAP_SIMILARITY_THRESHOLD=0.72
# Topic plans and final drafts fail closed below the acceptance score; a plan
# just under it is researched again rather than published.
# 82/48 is the audited default and what production should normally run. Lower it
# only to loosen a live site deliberately: the floors are 60 and 30, and the
# anti-duplicate gates (same-intent collision, evidence alignment, product
# binding) stay in force at every setting.
OPENCLAW_TOPIC_ACCEPTANCE_SCORE=82
OPENCLAW_TOPIC_MIN_NOVELTY_SUBTOTAL=48
OPENCLAW_TOPIC_AGENTIC_IDEATION_ENABLED=true
OPENCLAW_TOPIC_AGENTIC_WRITER_ENABLED=true
OPENCLAW_TOPIC_MAX_AGENT_ROUNDS=3
OPENCLAW_TOPIC_MAX_AGENT_CALLS=12
OPENCLAW_TOPIC_AGENT_TIMEOUT_MS=240000
OPENCLAW_TOPIC_AGENT_DEADLINE_MS=600000
# Comma-separated canonical provider model IDs approved for production topic agents.
OPENCLAW_TOPIC_ALLOWED_RESOLVED_MODELS=
# Canonical provider model pinned in the OpenClaw gateway configuration. It must
# be present in the allowlist above; missing or mismatched identity fails closed.
OPENCLAW_TOPIC_EXPECTED_RESOLVED_MODEL=
OPENCLAW_TOPIC_AGENT_STRICT_MODEL=true
OPENCLAW_SOURCE_RELEVANCE_MIN=0.58
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENCLAW_MARKET_RESEARCH_ENABLED=true
# Only curated public HTTPS sources configured by operators are fetched. Never
# populate this from user directions or model output. Comma-separated URLs.
OPENCLAW_MARKET_RESEARCH_SOURCE_URLS=
OPENCLAW_MARKET_RESEARCH_TTL_HOURS=24
OPENCLAW_MARKET_RESEARCH_TIMEOUT_MS=10000
OPENCLAW_MARKET_RESEARCH_MAX_RESPONSE_BYTES=524288
OPENCLAW_MARKET_RESEARCH_MAX_SOURCES=12
OPENCLAW_MARKET_RESEARCH_MAX_SIGNALS=30
# Optional query-directed evidence search. `disabled` makes no paid/outbound
# search calls. `firecrawl` requires FIRECRAWL_API_KEY from the secret store.
OPENCLAW_MARKET_SEARCH_PROVIDER=disabled
OPENCLAW_MARKET_SEARCH_MAX_QUERIES=6
OPENCLAW_MARKET_SEARCH_RESULTS_PER_QUERY=5
OPENCLAW_MARKET_SEARCH_TIMEOUT_MS=30000
FIRECRAWL_API_KEY=

INDUSTRY_RESEARCH_ENABLED=true
INDUSTRY_RESEARCH_MAX_SOURCES=8
INDUSTRY_RESEARCH_LOOKBACK_DAYS=90
INDUSTRY_RESEARCH_SOURCE_URLS=

# Content Operations Lifecycle V3. Both planning and cron are opt-in until a reviewed rollout.
CONTENT_OPERATIONS_ENABLED=false
CONTENT_OPERATIONS_TIMEZONE=Asia/Ho_Chi_Minh
CONTENT_OPERATIONS_CRON_ENABLED=false
CONTENT_OPERATIONS_DAILY_TIME=06:30
CONTENT_OPERATIONS_SNAPSHOT_TTL_HOURS=24
CONTENT_OPERATIONS_MAX_ACTIONS_PER_DAY=1
CONTENT_OPERATIONS_WORK_ORDER_LEASE_MINUTES=60
CONTENT_OPERATIONS_MIN_OPPORTUNITY_SCORE=0.65
CONTENT_OPERATIONS_MIN_USER_VALUE_SCORE=0.20
CONTENT_OPERATIONS_ALLOW_SKIP=true

CONTENT_INVENTORY_ENABLED=true
CONTENT_INVENTORY_SNAPSHOT_TTL_HOURS=24
CONTENT_INVENTORY_STALE_DAYS=180
CONTENT_INVENTORY_REVIEW_DAYS=90

CONTENT_SIGNALS_ENABLED=false
CONTENT_SIGNAL_DEFAULT_TTL_DAYS=90
CONTENT_SIGNAL_MAX_LENGTH=2000

CONTENT_PERFORMANCE_MONITORING_ENABLED=false
CONTENT_MONITOR_WINDOWS=1d,7d,14d,30d,90d
CONTENT_LEARNING_ENABLED=false
CONTENT_LEARNING_MIN_AGE_DAYS=14
CONTENT_LEARNING_MIN_IMPRESSIONS=100
CONTENT_LEARNING_AUTO_APPLY=false

SEARCH_CONSOLE_ENABLED=false
# Exact property granted to the mounted service account, for example sc-domain:example.com.
SEARCH_CONSOLE_PROPERTY=
SEARCH_CONSOLE_LOOKBACK_DAYS=90
CONTENT_ANALYTICS_ENABLED=false
CONTENT_TRENDS_ENABLED=false
CONTENT_TRENDS_PROVIDER=google_trends_rss
CONTENT_TRENDS_GEO=VN
CONTENT_TRENDS_MAX_SIGNALS=50
CONTENT_TRENDS_MAX_RESPONSE_BYTES=524288
CONTENT_PUBLISH_READINESS_ENABLED=true
CONTENT_POST_PUBLISH_VERIFY_ENABLED=true

CONTENT_ACTION_WEIGHT_USER_DEMAND=0.20
CONTENT_ACTION_WEIGHT_CONTENT_GAP=0.15
CONTENT_ACTION_WEIGHT_PERFORMANCE=0.15
CONTENT_ACTION_WEIGHT_BUSINESS=0.15
CONTENT_ACTION_WEIGHT_FRESHNESS=0.10
CONTENT_ACTION_WEIGHT_CUSTOMER_SIGNAL=0.10
CONTENT_ACTION_WEIGHT_PRODUCT_CAMPAIGN=0.05
CONTENT_ACTION_WEIGHT_EVIDENCE=0.05
CONTENT_ACTION_WEIGHT_INTERNAL_LINK=0.05

# Keep service-account JSON outside the Docker image and mount it read-only at runtime.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=./backend/credentials/file.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=

# Product relevance and contextual seeding intelligence
PRODUCT_SEEDING_ENABLED=true
PRODUCT_SEEDING_DEFAULT_MODE=auto
PRODUCT_SEEDING_DEFAULT_INTENSITY=light
PRODUCT_SEED_MIN_RELEVANCE_SCORE=0.72
PRODUCT_SEED_MAX_PRIMARY_PRODUCTS=1
PRODUCT_SEED_MAX_SUPPORTING_PRODUCTS=2
PRODUCT_SEED_LOOKBACK_DAYS=30
PRODUCT_SEED_PRODUCT_COOLDOWN_DAYS=7
PRODUCT_SEED_ALLOW_OUT_OF_STOCK=false
PRODUCT_SEED_REQUIRE_ACTIVE_PRODUCT=true
PRODUCT_SEED_REQUIRE_CANONICAL_URL=true
PRODUCT_SEED_MAX_MENTIONS_LIGHT=2
PRODUCT_SEED_MAX_MENTIONS_BALANCED=4
PRODUCT_SEED_MAX_MENTIONS_COMMERCIAL=6
PRODUCT_SEED_MAX_PRODUCT_LINKS=2
PRODUCT_SEED_MAX_CTA_COUNT=1
PRODUCT_CATALOG_SNAPSHOT_TTL_MINUTES=30
PRODUCT_CATALOG_MIN_DATA_COMPLETENESS=0.60

# Independent editorial product-placement strategy and deterministic gates
PRODUCT_PLACEMENT_ENABLED=true
PRODUCT_PLACEMENT_DEFAULT_STYLE=auto
PRODUCT_PLACEMENT_MIN_SECTIONS_BEFORE_PRODUCT=2
PRODUCT_PLACEMENT_MIN_WORDS_BEFORE_PRODUCT=350
PRODUCT_PLACEMENT_MIN_PROGRESS_PERCENT=35
PRODUCT_PLACEMENT_STYLE_LOOKBACK_DAYS=14
PRODUCT_PLACEMENT_STYLE_COOLDOWN_DAYS=5
PRODUCT_PLACEMENT_RANKING_POSITION_MODE=auto
PRODUCT_PLACEMENT_RANKING_POSITION_LOOKBACK_DAYS=14
PRODUCT_PLACEMENT_ALLOW_OWNED_PRODUCT_MIDDLE=false
PRODUCT_PLACEMENT_ALLOW_PRODUCT_IN_INTRO=false
PRODUCT_PLACEMENT_ALLOW_PRODUCT_IMAGE_FIRST=false
PRODUCT_PLACEMENT_ALLOW_CONSECUTIVE_PRODUCT_BLOCKS=false
PRODUCT_PLACEMENT_ALLOW_CONSECUTIVE_PRODUCT_IMAGES=false
PRODUCT_PLACEMENT_REQUIRE_DISCLOSURE=true
PRODUCT_PLACEMENT_REQUIRE_RANKING_METHODOLOGY=true
PRODUCT_PLACEMENT_REQUIRE_BESTSELLER_EVIDENCE=true
PRODUCT_PLACEMENT_MAX_BLOCKS_LIGHT=1
PRODUCT_PLACEMENT_MAX_BLOCKS_BALANCED=2
PRODUCT_PLACEMENT_MAX_CTA=1

# OpenClaw Visual SEO pipeline
OPENCLAW_IMAGE_PIPELINE_ENABLED=false
OPENCLAW_REQUIRE_COVER_IMAGE_FOR_PUBLISH=true
IMAGE_SEARCH_PROVIDER=disabled
IMAGE_SEARCH_API_KEY=
BING_IMAGE_SEARCH_ENDPOINT=
AI_IMAGE_PROVIDER=disabled
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_QUALITY=medium
AI_IMAGE_PIPELINE_ATTEMPT_LIMIT=1
AI_IMAGE_PIPELINE_CONCURRENCY=2
AI_IMAGE_REPLICATE_MODEL=
# For 9router use AI_IMAGE_PROVIDER=9router and AI_IMAGE_MODEL=cx/gpt-5.5-image.
# The backend uses NINE_ROUTER_API_KEY for this provider; AI_IMAGE_API_KEY is ignored.
IMAGE_MAX_INLINE_COUNT=4
IMAGE_COVER_WIDTH=1200
IMAGE_COVER_HEIGHT=675
IMAGE_OG_WIDTH=1200
IMAGE_OG_HEIGHT=630
IMAGE_MAX_FILE_SIZE_KB=350

# OpenClaw publisher runtime
OPENCLAW_GATEWAY_HTTP_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Local development may use these repository-relative defaults. Production
# must inject absolute, writable directories outside the repository checkout.
OPENCLAW_DATA_HOST_PATH=./deploy/openclaw/data
OPENCLAW_WORKSPACES_HOST_PATH=./deploy/openclaw/workspaces
OPENCLAW_UPDATE_ENABLED=false
OPENCLAW_NO_AUTO_UPDATE=1
INOXPRAN_BACKEND_API_BASE=http://backend:3056/v1/api
INOXPRAN_PUBLIC_SITE_URL=https://inoxpran.com
INOXPRAN_SEO_AGENT_AUTO_PUBLISH=false
INOXPRAN_SEO_AGENT_API_KEY=
INOXPRAN_SEO_AGENT_HMAC_SECRET=

# Optional n8n profile. It remains stopped unless COMPOSE_PROFILES contains
# "automation". Do not rotate N8N_ENCRYPTION_KEY without migrating stored
# credentials first.
COMPOSE_PROFILES=
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=
N8N_ENCRYPTION_KEY=
# Required when the automation profile is enabled. Production must inject an
# absolute, writable directory outside the repository checkout.
N8N_DATA_HOST_PATH=

# Optional operational integrations. Provision only the providers in use.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
GHTK_BASE_URL=https://services.giaohangtietkiem.vn
GHTK_API_TOKEN=
GHTK_CLIENT_SOURCE=
GHTK_PICK_ADDRESS_ID=
GHTK_PICK_ADDRESS=
GHTK_PICK_PROVINCE=
GHTK_PICK_DISTRICT=
GHTK_PICK_WARD=
GHTK_PICK_STREET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
WEB_PUSH_MAX_SUBSCRIPTIONS_PER_ADMIN=6
WEB_PUSH_TTL_SECONDS=180

# Blog cover poster: composes the editorial photo, the named product and the logo.
OPENCLAW_POSTER_COVER_ENABLED=false
# Attaches the catalog image and link when an article names an Inoxpran model.
PRODUCT_MENTION_IMAGE_ENABLED=true
